@using Sandbox
@using Sandbox.UI
@using System
@using System.Collections.Generic
@namespace Vehicles.Maintenance

<root class="toast-stack">
	@foreach ( var t in _items )
	{
		<div class="toast" style="animation-duration: @(t.Seconds)s;">
			<div class="edge"></div>
			<i class="ticon">notifications</i>
			<span class="msg">@t.Message</span>
			<div class="life" style="animation-duration: @(t.Seconds)s;"></div>
		</div>
	}
</root>

@code {
	class Item
	{
		public string Message;
		public RealTimeUntil Expire;
		public float Seconds;
	}

	static Toast _panel;
	readonly List<Item> _items = new();

	/// <summary>Show a transient on-screen message. Lazily mounts the single
	/// Toast panel under the scene's ScreenPanel (same mount as the HUD /
	/// part-select). Safe to call from anywhere.</summary>
	public static void Show( string message, float seconds = 3f )
	{
		if ( string.IsNullOrWhiteSpace( message ) ) return;

		if ( _panel?.IsValid() != true )
		{
			var root = VehicleUi.MountRoot();
			if ( root is null ) return;
			_panel = new Toast();
			_panel.Parent = root;
		}

		_panel._items.Add( new Item { Message = message, Expire = seconds, Seconds = seconds } );
	}

	public override void Tick()
	{
		base.Tick();
		_items.RemoveAll( i => i.Expire <= 0f );
	}

	public override void OnDeleted()
	{
		// Drop the static so a scene reload doesn't pin a dead panel.
		if ( _panel == this ) _panel = null;
		base.OnDeleted();
	}

	protected override int BuildHash()
	{
		int h = _items.Count;
		foreach ( var i in _items )
			h = HashCode.Combine( h, i.Message );
		return h;
	}
}
