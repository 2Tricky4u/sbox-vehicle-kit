@using Sandbox
@using Sandbox.UI
@using System
@using System.Linq
@namespace Vehicles.Maintenance

<root class="racing-hud @(Visible ? "" : "hidden") @(Visible && Target.IsWrecked ? "wrecked" : "")">
	@if ( Visible )
	{
		var v = Target;
		var kmh = (int)MathF.Round( MathF.Abs( v.KinematicVelocity.Length * 0.09144f ) );
		var maxKmh = v.Config.MaxSpeedKmh > 0 ? (int)v.Config.MaxSpeedKmh : 140;
		var spdFrac = MathX.Clamp( kmh / (float)maxKmh, 0f, 1f );
		var needle = Sweep( spdFrac );
		var rpmFrac = v.RedlineRpm > 1f ? MathX.Clamp( v.EngineRpm / v.RedlineRpm, 0f, 1f ) : 0f;
		var lit = (int)MathF.Round( rpmFrac * ShiftLights );
		var step = TickStep( maxKmh );

		<!-- speedometer: bottom-right -->
		<div class="right-cluster">
				<div class="dial">
					@for ( int s = 0; s <= maxKmh; s += step )
					{
						var frac = s / (float)maxKmh;
						var a = Sweep( frac );
						var major = (s % (step * 2) == 0);
						<div class="tick @(major ? "major" : "") @(frac >= 0.85f ? "redline" : "")"
							 style="left: @(PX( a, RTick ))px; top: @(PY( a, RTick ))px; transform: rotate(@(a)deg);"></div>
					}
					@for ( int s = 0; s <= maxKmh; s += step * 2 )
					{
						var a = Sweep( s / (float)maxKmh );
						<span class="tnum" style="left: @(PX( a, RNum ) - 16)px; top: @(PY( a, RNum ) - 9)px;">@s</span>
					}

					<!-- gear, beside the needle -->
					<div class="dgear @GearClass( v.CurrentGear )">@GearText( v.CurrentGear )</div>

					<div class="hub"></div>

					<!-- needle drawn LAST so it sits on top of the dial -->
					<div class="needle-pivot" style="transform: rotate(@(needle)deg);">
						<div class="needle"></div>
					</div>
				</div>
		</div>

		<!-- fuel gauge: bottom-left -->
		<div class="left-cluster">
				<div class="fuelgauge">
					@{
						var fp = MathX.Clamp( v.FuelPct, 0f, 1f );
						var fAng = FuelSweep( fp );
					}

					<!-- gas-pump watermark behind the ticks -->
					<i class="fglyph">local_gas_station</i>

					@for ( int q = 0; q <= 4; q++ )
					{
						var a = FuelSweep( q / 4f );
						<div class="ftick @(q == 0 ? "red" : "") @(q == 0 || q == 4 ? "major" : "")"
							 style="left: @(FX( a, FRTick ))px; top: @(FY( a, FRTick ))px; transform: rotate(@(a)deg);"></div>
					}
					<span class="fend e" style="left: @(FX( FuelSweep( 0f ), FRNum ) - 9)px; top: @(FY( FuelSweep( 0f ), FRNum ) - 8)px;">E</span>
					<span class="fend f" style="left: @(FX( FuelSweep( 1f ), FRNum ) - 9)px; top: @(FY( FuelSweep( 1f ), FRNum ) - 8)px;">F</span>

					<div class="fneedle-pivot" style="transform: rotate(@(fAng)deg);">
						<div class="fneedle @(fp < 0.15f ? "low" : "")"></div>
					</div>
					<div class="fhub"></div>

					<div class="fcap">
						<span class="ficon">FUEL</span>
						<span class="fpct @(fp < 0.15f ? "low" : "")">@((int)(fp * 100))%</span>
					</div>
				</div>
		</div>

		<!-- centre: KM/H | RPM readout, shift lights, tell-tales -->
		<div class="center-cluster">
			@if ( v.IsWrecked )
			{
				<div class="wreck-banner">
					<i>car_crash</i>
					<span>WRECKED — BODY REPAIR REQUIRED</span>
				</div>
			}

			<div class="speedline">
				<div class="grp">
					<span class="big">@kmh</span>
					<span class="lbl">KM/H</span>
				</div>
				<div class="sep"></div>
				<div class="grp">
					<span class="big">@((int)v.EngineRpm)</span>
					<span class="lbl">RPM</span>
				</div>
			</div>

			<!-- shift / rev lights -->
			<div class="shift">
				@for ( int i = 0; i < ShiftLights; i++ )
				{
					var on = i < lit;
					<div class="sl @ShiftClass( i ) @(on ? "on" : "")"></div>
				}
			</div>

			<!-- dashboard tell-tales: icon + label so state is never color alone -->
			<div class="tells">
				<div class="tell eng @(v.EngineHealthPct < 0.3f ? "on" : "")"><i>settings</i><span>CHECK</span></div>
				<div class="tell oil @(v.IsLowOil ? "on" : "")"><i>water_drop</i><span>OIL</span></div>
				<div class="tell bat @(v.BatteryPct < 0.15f ? "on" : "")"><i>battery_alert</i><span>BATT</span></div>
				<div class="tell tire @(v.TirePunctureMask != 0 ? "on" : "")"><i>trip_origin</i><span>TIRE</span></div>
				<div class="tell off @(!v.IsEngineRunning ? "on" : "")"><i>bolt</i><span>PWR</span></div>
				<div class="tell name"><span>@v.Config.DisplayName</span></div>
			</div>
		</div>
	}
</root>

@code {
	public static VehicleBase Target { get; private set; }
	static VehicleHud _panel;

	// Gauge geometry (must match the .scss .dial size).
	const float Size = 260f;
	const float C = 130f;       // centre
	const float RTick = 116f;   // tick radius
	const float RNum = 88f;     // number-label radius
	const int ShiftLights = 10;
	const float StartAng = -125f, EndAng = 125f; // needle sweep (deg, 0 = up)

	// Fuel gauge geometry (must match .scss .fuelgauge size). Pivot near the
	// bottom-centre; needle sweeps E (left) → F (right).
	const float FCx = 80f, FCy = 96f;   // pivot
	const float FRTick = 64f;           // tick radius
	const float FRNum = 80f;            // E/F label radius
	const float FStart = -84f, FEnd = 84f;

	bool Visible => Target?.IsValid() == true && Target.Config is not null;

	public static void Show( VehicleBase v )
	{
		Target = v;
		if ( _panel?.IsValid() == true ) return;

		var root = VehicleUi.MountRoot();
		if ( root is null ) return;

		_panel = new VehicleHud();
		_panel.Parent = root;
	}

	public static void Hide() => Target = null;

	public override void OnDeleted()
	{
		// Drop the statics so a scene reload doesn't pin a dead panel/vehicle.
		if ( _panel == this ) { _panel = null; Target = null; }
		base.OnDeleted();
	}

	static float Sweep( float frac ) => StartAng + (EndAng - StartAng) * MathX.Clamp( frac, 0f, 1f );
	static float PX( float angDeg, float r ) => C + r * MathF.Sin( angDeg * MathF.PI / 180f );
	static float PY( float angDeg, float r ) => C - r * MathF.Cos( angDeg * MathF.PI / 180f );

	static float FuelSweep( float frac ) => FStart + (FEnd - FStart) * MathX.Clamp( frac, 0f, 1f );
	static float FX( float angDeg, float r ) => FCx + r * MathF.Sin( angDeg * MathF.PI / 180f );
	static float FY( float angDeg, float r ) => FCy - r * MathF.Cos( angDeg * MathF.PI / 180f );

	static int TickStep( int maxKmh )
	{
		if ( maxKmh <= 80 ) return 10;
		if ( maxKmh <= 180 ) return 20;
		return 40;
	}

	string ShiftClass( int i )
	{
		if ( i >= ShiftLights - 2 ) return "red";
		if ( i >= ShiftLights - 5 ) return "amber";
		return "green";
	}

	string GearText( int g ) => g switch { -1 => "R", 0 => "N", _ => g.ToString() };
	string GearClass( int g ) => g switch { -1 => "rev", 0 => "neutral", _ => "drive" };

	protected override int BuildHash()
	{
		var stateHash = HashCode.Combine(
			Target,
			Target?.EngineRpm ?? 0f,
			Target?.CurrentGear ?? 0,
			(int)((Target?.KinematicVelocity.Length ?? 0f) * 0.09144f),
			Target?.FuelPct ?? 0f,
			Target?.EngineHealthPct ?? 0f,
			Target?.OilPct ?? 0f,
			Target?.TirePunctureMask ?? 0u );
		// Second stage so the new visual states refresh too (Combine caps at 8 args).
		return HashCode.Combine( stateHash,
			Target?.IsWrecked ?? false,
			Target?.IsEngineRunning ?? false,
			Target?.IsLowOil ?? false,
			(int)((Target?.BatteryPct ?? 1f) * 20f) );
	}
}
