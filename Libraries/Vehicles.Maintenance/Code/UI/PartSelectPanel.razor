@using Sandbox
@using Sandbox.UI
@using System
@using System.Linq
@namespace Vehicles.Maintenance

<root class="part-select-panel">
	<div class="top-strip"></div>

	<div class="header">
		<i class="hicon">handyman</i>
		<div class="htext">
			<span class="title">PARTS CRATE</span>
			<span class="sub">SELECT A REPAIR PART</span>
		</div>
		<button class="close-x" @onclick=@Close><i>close</i></button>
	</div>

	<div class="grid">
		@foreach ( var def in PartDefinition.All )
		{
			var part = def;
			var count = CountOf( part );
			var selected = Tool?.CurrentPart == part;
			<div class="card @(count > 0 ? "" : "empty") @(selected ? "selected" : "")" @onclick=@(() => Pick( part ))>
				<div class="badge @(count > 0 ? "" : "zero")">×@count</div>
				<i class="picon">@KindIcon( part.RepairsPart )</i>
				<span class="pname">@part.DisplayName</span>
				<span class="pkind">@part.RepairsPart</span>
				<div class="pprice"><i>paid</i><span>$@part.Price</span></div>
				@if ( selected )
				{
					<div class="sel-tag"><i>check_circle</i><span>EQUIPPED</span></div>
				}
			</div>
		}
	</div>

	@if ( !PartDefinition.All.Any() )
	{
		<div class="empty-state">
			<i>inventory_2</i>
			<span>No part definitions found</span>
		</div>
	}
</root>

@code {
	/// <summary>The RepairTool this panel writes its choice back to.</summary>
	public RepairTool Tool { get; set; }

	/// <summary>Whose inventory to show. Defaults to the tool's owner / local.</summary>
	public Connection Mechanic { get; set; }

	public Action OnClose { get; set; }

	static PartSelectPanel _active;

	Connection ResolveMechanic()
		=> Mechanic ?? Tool?.GameObject?.Network?.Owner ?? Connection.Local;

	int CountOf( PartDefinition def )
	{
		if ( def is null || VehicleHost.Current is null ) return 0;
		var conn = ResolveMechanic();
		if ( conn is null ) return 0;
		return VehicleHost.Current.GetInventory( conn )?.CountOf( def ) ?? 0;
	}

	// Material Icons ligature per part kind (glyphs verified in the shipped font).
	static string KindIcon( PartKind kind ) => kind switch
	{
		PartKind.Engine => "settings",
		PartKind.Body => "car_repair",
		PartKind.Tire => "trip_origin",
		PartKind.Battery => "battery_charging_full",
		PartKind.Oil => "oil_barrel",
		_ => "build",
	};

	void Pick( PartDefinition def )
	{
		if ( Tool.IsValid() ) Tool.CurrentPart = def;
		Close();
	}

	void Close() => OnClose?.Invoke();

	// ── Static lifecycle (mirrors the vh.diag pattern) ────────────────
	public static void Toggle( RepairTool tool )
	{
		if ( _active?.IsValid() == true ) CloseActive();
		else Open( tool );
	}

	public static void Open( RepairTool tool )
	{
		if ( _active?.IsValid() == true ) _active.Delete();

		var root = VehicleUi.MountRoot();
		if ( root is null ) return;

		var panel = new PartSelectPanel { Tool = tool };
		panel.Parent = root;
		panel.OnClose = () =>
		{
			panel.Delete();
			if ( _active == panel ) _active = null;
		};
		_active = panel;
	}

	public static void CloseActive()
	{
		if ( _active?.IsValid() != true ) { _active = null; return; }
		_active.OnClose?.Invoke();
	}

	public override void OnDeleted()
	{
		// Drop the static so a scene reload doesn't pin a dead panel.
		if ( _active == this ) _active = null;
		base.OnDeleted();
	}

	protected override int BuildHash()
	{
		int invHash = HashCode.Combine( Tool, Tool?.CurrentPart );
		if ( VehicleHost.Current is not null )
		{
			foreach ( var def in PartDefinition.All )
				invHash = HashCode.Combine( invHash, def, CountOf( def ) );
		}
		return invHash;
	}
}
